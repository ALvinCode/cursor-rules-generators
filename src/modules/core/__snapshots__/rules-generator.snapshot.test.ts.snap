  pageSize: number;
}
\`\`\`

### 2. API Functions

\`\`\`ts
// src/api/client.ts
import type { ClientItem, ClientListParams } from "@/types/client";


export const fetchClientList = (params: ClientListParams) => {
  return apiClient.get<ClientItem[]>("/clients", { params });
};
\`\`\`

### 3. Store（Zustand）

\`\`\`ts
// src/store/clientStore.ts
import { create } from "zustand";
import type { ClientItem } from "@/types/client";

interface ClientStore {
  items: ClientItem[];
  loading: boolean;
  fetchItems: () => Promise<void>;
}

export const useClientStore = create<ClientStore>((set) => ({
  items: [],
  loading: false,
  fetchItems: async () => {
    set({ loading: true });
    const items = await fetchClientList();
    set({ items, loading: false });
  },
}));
\`\`\`

### 4. Reusable Hook (Optional)

\`\`\`ts
// src/hooks/useClient.ts
export function useClient(id: string) {
  // Encapsulate data fetching, loading state, and error handling
  // Components call this directly; don't duplicate fetch logic
}
\`\`\`

### 5. Page Component

\`\`\`tsx
// src/pages/ClientList/ClientList.tsx
// Rendering only; business logic lives in Hook / Store
export function ClientList() {
  // 1. Get data from store/hook
  // 2. Handle loading / error states
  // 3. Render the list
}
\`\`\`

### 6. Route Registration

\`\`\`tsx
// src/index.tsx or route config file
{ path: "/clients", element: <ClientList /> }
{ path: "/clients/:id", element: <ClientDetail /> }
\`\`\`

## File Checklist

After adding a feature, confirm the following files were created/updated:

- [ ] \`src/types/client.ts\` — Type definitions
- [ ] \`src/api/client.ts\` — API functions
- [ ] \`src/store/clientStore.ts\` — Store
- [ ] \`src/hooks/useClient.ts\` — Data hook (optional)
- [ ] \`src/pages/ClientList/\` — Page component
- [ ] Route config updated

---

*Follow this pattern for project consistency. See @project-structure.mdc for actual directory locations.*
